# Whoosh'd — llama.cpp / GGUF adapter example env
# Requires a running llama.cpp server or a GGUF model file.
# Copy to .env and configure paths / URLs.
#
# Option A: external llama.cpp server
#   WHOOSHD_LLAMA_CPP_SERVER_URL=http://127.0.0.1:8080
#
# Option B: managed local server
#   WHOOSHD_LLAMA_CPP_MODEL_PATH=/path/to/model.gguf
#   WHOOSHD_LLAMA_CPP_AUTO_START=true

WHOOSHD_ADAPTER=llama_cpp
WHOOSHD_LLAMA_CPP_HOST=127.0.0.1
WHOOSHD_LLAMA_CPP_PORT=8080
