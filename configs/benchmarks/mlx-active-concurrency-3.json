{
  "schema_version": "1.0",
  "name": "mlx-active-concurrency-3",
  "description": "Active MLX concurrency = 3 for Gemma 4 12B IT QAT. Tests whether 3-way parallelism improves aggregate throughput.",
  "model_id": "mlx-community/gemma-4-12b-it-qat-4bit",
  "runtime": "mlx_lm_server",
  "expected_hardware": "Apple Silicon, 32GB+ unified memory",
  "client_concurrency": 6,
  "active_inference_concurrency": 3,
  "queue_depth": 8,
  "queue_timeout_seconds": 300,
  "streaming": true,
  "workload_class": "mixed_coding_tasks",
  "environment": {
    "WHOOSHD_ENABLE_QUEUE": "true",
    "WHOOSHD_MAX_QUEUE_DEPTH": "8",
    "WHOOSHD_QUEUE_TIMEOUT_SECONDS": "300",
    "WHOOSHD_MAX_ACTIVE_REQUESTS": "3",
    "WHOOSHD_MLX_MAX_CONCURRENT_REQUESTS": "3",
    "WHOOSHD_MLX_ENABLED": "true"
  },
  "invocation": {
    "start_server": ".venv/bin/python -m uvicorn whooshd.app:app --host 127.0.0.1 --port 8000",
    "bench": "python -m whooshd.bench.runner --base-url http://127.0.0.1:8000 --model mlx-community/gemma-4-12b-it-qat-4bit --concurrency 6 --requests 24 --stream --max-tokens 256"
  },
  "expected_outcome": {
    "completed": 24,
    "queued": ">=15",
    "rejected": 0,
    "failed": 0,
    "stuck": 0
  },
  "pass_criteria": [
    "All 24 requests complete with status 200",
    "Aggregate throughput >= 1.3x of x2",
    "TTFT p95 < 2x of x2",
    "No memory-pressure warnings"
  ]
}